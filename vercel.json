{
  "redirects": [
    {
      "source": "/chocolate.html",
      "destination": "/shop-online.html",
      "permanent": false
    },
    {
      "source": "/online-shop.html",
      "destination": "/shop-online.html",
      "permanent": false
    },
    {
      "source": "/cards.html",
      "destination": "/shop-online.html",
      "permanent": false
    },
    {
      "source": "/gifts.html",
      "destination": "/shop-online.html",
      "permanent": false
    },
    {
      "source": "/range.html",
      "destination": "/shop-online.html",
      "permanent": false
    },
    {
      "source": "/basket.html",
      "destination": "/shop-online.html",
      "permanent": false
    },
    {
      "source": "/view-all.html",
      "destination": "/shop-online.html",
      "permanent": false
    },
    {
      "source": "/shop-checkout-success.html",
      "destination": "/shop-online.html",
      "permanent": false
    },
    {
      "source": "/shop-checkout-cancelled.html",
      "destination": "/shop-online.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/catalogue.js",
      "destination": "/api/catalogue"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
