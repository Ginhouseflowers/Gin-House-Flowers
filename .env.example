# Copy to .env for local development (netlify dev loads this automatically)

# Password for the online stock panel (triple-click the logo)
STOCK_PASSWORD=

# Brevo mailing list (free plan: https://www.brevo.com). Create an API key and a list,
# then paste both here so newsletter signups are added to that list.
BREVO_API_KEY=
BREVO_LIST_ID=

# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Optional: webhook signing secret (Stripe CLI or Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Site URL (no trailing slash) — used for Checkout return URLs
URL=http://localhost:8888

# Email is sent through your own mailbox (the SMTP settings from your email host's control panel).
# Use a dedicated mailbox such as website@ so the main info@ password isn't stored here.
SMTP_HOST=mail.ginhouseflowers.co.uk
SMTP_PORT=465
SMTP_USER=website@ginhouseflowers.co.uk
SMTP_PASS=
# Optional "From" name/address (defaults to SMTP_USER)
# SMTP_FROM=Gin House Flowers <website@ginhouseflowers.co.uk>

# Where order and enquiry notifications are delivered
ORDER_NOTIFY_EMAIL=info@ginhouseflowers.co.uk
# Contact page enquiries (defaults to ORDER_NOTIFY_EMAIL)
CONTACT_NOTIFY_EMAIL=info@ginhouseflowers.co.uk

# Optional fallback: Resend (https://resend.com), only used if the SMTP settings are blank
# RESEND_API_KEY=

# Google Analytics 4 measurement ID (Admin → Data streams → Web). Leave blank to switch
# analytics and the cookie banner off. Visitors are only tracked after they click Accept.
GA_MEASUREMENT_ID=
